APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_appsline
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Notificaciones de tareas por correo (docs/EMAIL_NOTIFICATIONS.md)
# ---------------------------------------------------------------------------
# Zona horaria de la app: define a qué hora salen los correos programados.
APP_TIMEZONE=America/Mexico_City
# URL del frontend donde se ven las tareas (los correos enlazan aquí).
# Si el frontend vive en el mismo dominio que la API, usa la misma APP_URL.
FRONTEND_URL=http://localhost
# Correos que reciben el reporte semanal general (viernes 20:00), separados por coma.
TASK_WEEKLY_REPORT_RECIPIENTS=
# Enviar también el resumen semanal personal a cada usuario.
TASK_WEEKLY_REPORT_TO_USERS=true
# Avisar también cuando alguien se asigna una tarea a sí mismo.
TASK_NOTIFY_SELF_ASSIGNMENT=false
# Los correos van por la cola (QUEUE_CONNECTION=database): en el servidor
# debe correr `php artisan queue:work` y el scheduler de Laravel (cron):
# * * * * * cd /ruta/del/proyecto && php artisan schedule:run >> /dev/null 2>&1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Documentación de la API (Scramble) -> /docs
# ---------------------------------------------------------------------------
# DOCS_ENABLED=false apaga la referencia y el documento OpenAPI.
DOCS_ENABLED=true
# Entornos (APP_ENV) en los que se sirve la documentación. Producción fuera por defecto.
# Usa DOCS_ENVIRONMENTS=* para servirla en cualquier entorno (o añade production a la lista).
# Tras cambiar estas variables: php artisan config:clear
DOCS_ENVIRONMENTS=local,development,testing,staging
SCRAMBLE_TITLE="Appsline API"
API_VERSION=1.0.0
